# Copy this file to .env and fill in real values. Never commit the real .env file.

# PostgreSQL connection string
DATABASE_URL=postgresql://nyayasarthi:nyayasarthi@localhost:5432/nyayasarthi

# Get this free from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Any long random string — used to sign login tokens
JWT_SECRET=change-this-to-a-long-random-string

# dev | staging | production
ENV=dev

# Once deployed, set this to your real frontend URL (e.g. https://nyayasarthi.vercel.app)
# so the browser is allowed to call this API. Leave blank for local development.
FRONTEND_URL=
