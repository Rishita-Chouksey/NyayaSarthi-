nyayasarthi-backend/.env
nyayasarthi-frontend/.env
# ── Secrets — never commit these ──
.env

# ── Python (backend) ──
__pycache__/
*.py[cod]
*.egg-info/
venv/
env/
.venv/
*.db
*.sqlite3

# Alembic autogenerated cache (keep the migration files themselves)
**/versions/__pycache__/

# ── Uploaded judgment PDFs (user data, not source code) ──
nyayasarthi-backend/uploaded_judgments/*
!nyayasarthi-backend/uploaded_judgments/.gitkeep

# ── Node / Vite (frontend) ──
node_modules/
dist/
dist-ssr/
*.local

# ── Editor / OS clutter ──
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# ── Logs ──
*.log
npm-debug.log*